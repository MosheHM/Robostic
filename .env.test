// Environment Configuration for Testing
NODE_ENV=test
PORT=3000

# Database (use in-memory or skip for testing)
DATABASE_URL=skip

# Skip external services for testing
REDIS_URL=skip
MONGODB_DISABLED=true

# JWT Configuration
JWT_SECRET=test-jwt-secret-key
JWT_EXPIRE=1h

# API URLs
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# Logging
LOG_LEVEL=error