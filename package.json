{
  "name": "robostic",
  "version": "1.0.0",
  "description": "AI Robotics Cloud Platform - Democratizing robot development through cloud-native AI solutions",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "echo 'Backend build complete'",
    "build:frontend": "cd frontend && npm run build",
    "docker:build": "docker build -t robostic .",
    "docker:run": "docker run -p 3000:3000 robostic",
    "setup": "npm install && cd frontend && npm install"
  },
  "keywords": [
    "robotics",
    "ai",
    "cloud",
    "automation",
    "simulation",
    "computer-vision",
    "machine-learning",
    "iot"
  ],
  "author": "Robostic Inc.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/MosheHM/Robostic.git"
  },
  "bugs": {
    "url": "https://github.com/MosheHM/Robostic/issues"
  },
  "homepage": "https://github.com/MosheHM/Robostic#readme",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "mongoose": "^7.5.0",
    "joi": "^17.9.2",
    "socket.io": "^4.7.2",
    "mqtt": "^5.0.5",
    "multer": "^1.4.5-lts.1",
    "compression": "^1.7.4",
    "rate-limiter-flexible": "^3.0.3",
    "winston": "^3.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "node-cron": "^3.0.2",
    "axios": "^1.5.0",
    "three": "^0.155.0",
    "ws": "^8.14.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.4",
    "supertest": "^6.3.3",
    "eslint": "^8.47.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "@types/jest": "^29.5.4",
    "concurrently": "^8.2.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js"
    ]
  },
  "eslintConfig": {
    "extends": ["standard"],
    "env": {
      "node": true,
      "jest": true
    }
  }
}